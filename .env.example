# Copy this file to .env (same folder) and fill it in to email the supervisor (US-33).
# .env is never committed: it holds a password. This example file has no secrets.
#
# Gmail (easiest for a demo): turn on 2-Step Verification, then create an App password at
# https://myaccount.google.com/apppasswords and paste the 16 letters as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=
SMTP_FROM=yourname@gmail.com
